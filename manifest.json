{
  "manifest_version": 3,
  "name": "JS Runner",
  "version": "1.0.0",
  "description": "Run JavaScript on any page from a small corner panel, without opening DevTools.",
  "permissions": ["scripting", "storage", "userScripts", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JS Runner (Alt+Shift+J)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Toggle the JS Runner panel"
    }
  }
}
